{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:morrow:campaign:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceKind": {
      "const": "live-read-verified"
    },
    "campaignId": {
      "enum": [
        "gate",
        "a",
        "b"
      ]
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
    },
    "implementationCommit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "commitBlocker": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "networks": {
      "type": "object",
      "properties": {
        "sourceEvmChainId": {
          "const": "11155111"
        },
        "destinationEvmChainId": {
          "const": "102031"
        },
        "attestcoinChainKey": {
          "const": "1"
        }
      },
      "required": [
        "sourceEvmChainId",
        "destinationEvmChainId",
        "attestcoinChainKey"
      ],
      "additionalProperties": false
    },
    "deployments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/deployment"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "chainId": {
            "enum": [
              "11155111",
              "102031"
            ]
          },
          "decimals": {
            "const": 6
          },
          "testToken": {
            "const": true
          }
        },
        "required": [
          "address",
          "chainId",
          "decimals",
          "testToken"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    },
    "terms": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "sourceEvmChainId": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "sourceVault": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "claimId": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "round": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "destinationEvmChainId": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "destinationMarket": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "seller": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "buyer": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "sourceToken": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "sourceFaceValueRaw": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "maturity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "settlementToken": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "grossPurchasePriceRaw": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "feeBps": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "feeRecipient": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "fundBefore": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "assignBefore": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        }
      },
      "required": [
        "protocolVersion",
        "sourceEvmChainId",
        "sourceVault",
        "claimId",
        "round",
        "destinationEvmChainId",
        "destinationMarket",
        "seller",
        "buyer",
        "sourceToken",
        "sourceFaceValueRaw",
        "maturity",
        "settlementToken",
        "grossPurchasePriceRaw",
        "feeBps",
        "feeRecipient",
        "fundBefore",
        "assignBefore"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "encodedTerms": {
          "type": "string",
          "pattern": "^0x(?:[0-9a-fA-F]{2})*$",
          "minLength": 1154,
          "maxLength": 1154
        },
        "termsHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "saleId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "claimKey": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "encodedTerms",
        "termsHash",
        "saleId",
        "claimKey"
      ],
      "additionalProperties": false
    },
    "transactions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/transaction"
      },
      "minItems": 3,
      "maxItems": 10000
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/proof"
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/snapshot"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "timeline": {
      "$ref": "#/definitions/artifact"
    },
    "stateHistory": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/artifact"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "withdrawals": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/transaction"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "phaseTimings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "observedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
          },
          "inclusionToObservedMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "proofConstructionMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "action",
          "observedAt",
          "inclusionToObservedMs",
          "proofConstructionMs"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "observedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
          },
          "error": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "action",
          "observedAt",
          "error"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "expectedOutcome": {
      "enum": [
        "assigned-and-redeemed",
        "cancelled-refunded-and-redeemed"
      ]
    },
    "actualOutcome": {
      "type": "object",
      "properties": {
        "sourceRoundState": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "destinationState": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "redeemed": {
          "type": "boolean"
        }
      },
      "required": [
        "sourceRoundState",
        "destinationState",
        "redeemed"
      ],
      "additionalProperties": false
    },
    "independentChecker": {
      "anyOf": [
        {
          "$ref": "#/definitions/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "unresolvedFacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "required": [
    "schemaVersion",
    "evidenceKind",
    "campaignId",
    "generatedAt",
    "implementationCommit",
    "commitBlocker",
    "networks",
    "deployments",
    "tokens",
    "terms",
    "identity",
    "transactions",
    "proofs",
    "snapshots",
    "timeline",
    "stateHistory",
    "withdrawals",
    "phaseTimings",
    "failures",
    "expectedOutcome",
    "actualOutcome",
    "independentChecker",
    "unresolvedFacts"
  ],
  "additionalProperties": false,
  "definitions": {
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "transaction": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "chainId": {
          "enum": [
            "11155111",
            "102031"
          ]
        },
        "transactionHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "blockNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "receiptStatus": {
          "enum": [
            0,
            1
          ]
        },
        "observedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
        },
        "receipt": {
          "$ref": "#/definitions/artifact"
        }
      },
      "required": [
        "action",
        "chainId",
        "transactionHash",
        "blockNumber",
        "blockHash",
        "receiptStatus",
        "observedAt",
        "receipt"
      ],
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "vault",
            "market",
            "sourceToken",
            "settlementToken"
          ]
        },
        "chainId": {
          "enum": [
            "11155111",
            "102031"
          ]
        },
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "transactionHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "runtimeCodeHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "constructorArguments": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            ]
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "artifact": {
          "$ref": "#/definitions/artifact"
        }
      },
      "required": [
        "role",
        "chainId",
        "address",
        "transactionHash",
        "runtimeCodeHash",
        "constructorArguments",
        "artifact"
      ],
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "properties": {
        "sourceTransactionHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "sourceBlock": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "receiptLocalLogIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nativeTransactionIndex": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "eventKey": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "nativeVerified": {
          "const": true
        },
        "observedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
        },
        "artifact": {
          "$ref": "#/definitions/artifact"
        },
        "decodedEvent": {
          "type": "object",
          "properties": {
            "name": {
              "enum": [
                "SaleReserved",
                "SaleAssigned",
                "SaleCancelled"
              ]
            },
            "saleId": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            "claimId": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "round": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "termsHash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            }
          },
          "required": [
            "name",
            "saleId",
            "claimId",
            "round",
            "termsHash"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sourceTransactionHash",
        "sourceBlock",
        "receiptLocalLogIndex",
        "nativeTransactionIndex",
        "eventKey",
        "nativeVerified",
        "observedAt",
        "artifact",
        "decodedEvent"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "chainId": {
          "enum": [
            "11155111",
            "102031"
          ]
        },
        "blockNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "vault",
                  "market",
                  "sourceToken",
                  "settlementToken"
                ]
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 256
                },
                "minItems": 0,
                "maxItems": 10000
              },
              "raw": {
                "type": "string",
                "pattern": "^0x(?:[0-9a-fA-F]{2})*$"
              }
            },
            "required": [
              "role",
              "method",
              "args",
              "raw"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "chainId",
        "blockNumber",
        "blockHash",
        "timestamp",
        "reads"
      ],
      "additionalProperties": false
    }
  }
}
